<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LiveScore</title><style>body{background:#0f172a;color:#fff;font-family:Arial;margin:0}.top{background:#1e293b;padding:14px;display:flex;justify-content:space-between;position:sticky;top:0}.badge{background:#22c55e;color:#000;padding:2px 10px;border-radius:20px;font-size:11px;font-weight:bold}#list{max-width:700px;margin:auto;padding:12px}.card{background:#1e293b;margin:10px 0;padding:12px;border-radius:10px;border-left:4px solid #22c55e}.lg{font-size:11px;color:#94a3b8}.rw{display:flex;justify-content:space-between;margin-top:6px;font-weight:bold}.sc{text-align:center;margin:8px 0;font-size:22px;color:#22c55e;font-weight:900}.st{text-align:center;font-size:11px;color:#fbbf24}</style></head><body><div class="top"><b>⚽ LiveScores</b><span class="badge">LIVE</span></div><div id="list" style="text-align:center;padding:40px">Loading live games...</div><script>async function load(){try{let r=await fetch('/api/matches');let j=await r.json();let d=j.data||[];if(d.matches)d=d.matches;if(!d.length){document.getElementById('list').innerHTML='No games today<br><small style=color:#94a3b8>'+(j.error||'')+'</small>';return}let h=`<p style=color:#94a3b8;font-size:12px>${d.length} games</p>`;d.slice(0,150).forEach(m=>{let hm=m.home_team?.name||m.home_team||m.teams?.home?.name||'Home';let am=m.away_team?.name||m.away_team||m.teams?.away?.name||'Away';let hs=m.home_score??m.scores?.home??'-';let as=m.away_score??m.scores?.away??'-';let lg=m.league?.name||m.competition||'League';let st=m.status?.short||m.status||'';h+=`<div class=card><div class=lg>${lg}</div><div class=rw><span>${hm}</span><span>${am}</span></div><div class=sc>${hs} - ${as}</div><div class=st>${st}</div></div>`});document.getElementById('list').innerHTML=h}catch(e){document.getElementById('list').innerHTML='Error: '+e.message}}load();setInterval(load,30000)</script></body></html>
